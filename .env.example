# Copy to .env and adjust. The `ct` entry point loads the user-tunable
# knobs below at import time; `uv run ct <subcommand>` picks them up.
# Path-like variables (AIRFLOW_HOME, CRYPTO_DB_PATH, PYTHONPATH) are NOT
# loaded from this file — `ct` sets them to absolute paths anchored at
# the repo root so subprocesses (dbt, airflow) always find them.
# A real shell env (`CRYPTO_FIAT_CURRENCIES=... uv run ct ...`) still wins.
#
# No API keys are required: CoinGecko's free tier and Frankfurter are both
# keyless.

# CoinGecko coin ids. More coins means more per-coin history requests, which the
# keyless rate limit constrains; raise INTER_COIN_SLEEP_SECONDS if you add many.
CRYPTO_TRACKED_COINS=bitcoin,ethereum,solana,cardano,ripple,polkadot,chainlink,dogecoin,avalanche-2,litecoin

# Reporting currencies. Must be present in ECB's set or Frankfurter returns 422.
CRYPTO_FIAT_CURRENCIES=EUR,GBP,JPY,IDR,SGD,AUD,CHF,CAD

# Ingest log verbosity.
CRYPTO_LOG_LEVEL=INFO

# Optional: seconds to sleep between CoinGecko history requests. Default 3.
# Raise to 5+ if you hit 429 errors frequently.
# INTER_COIN_SLEEP_SECONDS=3
